# ==========================================
# Production Environment Configuration (Server)
# ==========================================
ENV_PREFIX=prod
NODE_ENV=production

# Production Domains
DOMAIN_NAME=tickets.birlaopenminds.com
API_DOMAIN_NAME=api.birlaopenminds.com

# Traefik Docker Network & Resolver (Hostinger VPS)
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
LETSENCRYPT_RESOLVER=letsencrypt

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=B!rl@@3210$
POSTGRES_DB=bom_service_hub_prod

# NestJS Server Configuration
PORT=5000
API_PREFIX=api
API_VERSION=1

# Security Keys & JWT Secrets
JWT_SECRET=qY0VmIw44R7oL7OVB8emoFiMgdc5KPLWSeHKQohe9zX
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=3fMAetyzK26xAsQD7no84YMGHY9lf8tLDUmqpVFCyGe
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=36tQczh4HRW1j9CGtQ7R0kdByzTmf2cFxI8PbsinbOw

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# File Upload Configuration
MAX_FILE_SIZE=10485760 # 10MB
UPLOAD_DEST=./public/uploads

# Mailer Configuration (SMTP)

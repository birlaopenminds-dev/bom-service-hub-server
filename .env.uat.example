# ==========================================
# UAT Environment Configuration (Server)
# ==========================================
ENV_PREFIX=uat
NODE_ENV=production

# Host Port Mapping for Nginx Proxy
SERVER_HOST_PORT=5000

# UAT Domains
DOMAIN_NAME=uat-tickets.birlaopenminds.com
API_DOMAIN_NAME=uat-admin.birlaopenminds.com

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=bom_service_hub_uat

# NestJS Server Configuration
PORT=5000
API_PREFIX=api
API_VERSION=1

# Security Keys & JWT Secrets
JWT_SECRET=your_jwt_access_secret_key_here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=your_cookie_secret_key_here
ALLOWED_ORIGINS=https://uat-tickets.birlaopenminds.com,https://uat-admin.birlaopenminds.com

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# File Upload Configuration
MAX_FILE_SIZE=10485760 # 10MB
UPLOAD_DEST=./public/uploads

# Mailer Configuration (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_smtp_username
MAIL_PASS=your_smtp_password
MAIL_FROM="BOM ServiceHub UAT <noreply@birlaopenminds.com>"

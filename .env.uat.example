# ==========================================
# UAT Environment Configuration (Server)
# ==========================================
ENV_PREFIX=uat
NODE_ENV=production

# Host Port Mapping for Nginx Proxy
SERVER_HOST_PORT=5000

# Domains
DOMAIN_NAME=uat-tickets.birlaopenminds.com
API_DOMAIN_NAME=uat-admin.birlaopenminds.com

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=bom_service_hub_uat

# Note: If your password contains special characters like '@', '!', or '$', URL-encode them:
# '@' -> '%40', '!' -> '%21', '$' -> '%24'
# Example: postgresql://postgres:Welcome%40123@postgres:5432/bom_service_hub_uat?schema=public
DATABASE_URL="postgresql://postgres:your_password_here@postgres:5432/bom_service_hub_uat?schema=public"

# NestJS Server Configuration
PORT=5000
API_PREFIX=api
API_VERSION=1

# Security Keys & JWT Secrets
JWT_SECRET=qY0VmIw44R7oL7OVB8emoFiMgdc5KPLWSeHKQohe9zX
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=3fMAetyzK26xAsQD7no84YMGHY9lf8tLDUmqpVFCyGe
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=36tQczh4HRW1j9CGtQ7R0kdByzTmf2cFxI8PbsinbOw
ALLOWED_ORIGINS=https://uat-tickets.birlaopenminds.com,https://uat-admin.birlaopenminds.com

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# File Upload Configuration
MAX_FILE_SIZE=10485760 # 10MB
UPLOAD_DEST=./public/uploads

# Mailer Configuration (Office 365 / SMTP)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=tickets@Birlaopenminds.com
SMTP_PASS=your_smtp_password_here
MAIL_FROM=tickets@Birlaopenminds.com
MAIL_FROM_NAME="BOM ServiceHub"

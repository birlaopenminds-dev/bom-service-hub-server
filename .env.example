# ==========================================
# Traefik & Domain Configuration (Hostinger VPS)
# ==========================================
DOMAIN_NAME=app.yourdomain.com
API_DOMAIN_NAME=api.yourdomain.com

# Traefik External Network Name in Hostinger Docker Manager
# Common values in Hostinger: 'proxy', 'traefik-net', or 'traefik_default'
TRAEFIK_NETWORK=proxy

# Traefik Entrypoint ('websecure' for HTTPS, 'web' for HTTP)
TRAEFIK_ENTRYPOINT=websecure

# Traefik Let's Encrypt Certificate Resolver
# Common values: 'letsencrypt', 'myresolver', or 'le'
LETSENCRYPT_RESOLVER=letsencrypt

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_strong_db_password
POSTGRES_DB=bom_service_hub

# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=production
PORT=5000
API_PREFIX=api
API_VERSION=1

# Application Security & Auth Keys
JWT_SECRET=super_secret_jwt_access_key_bom_service_hub_2026
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_bom_service_hub_2026
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=super_secret_cookie_key_bom_service_hub

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# File Upload Configuration
MAX_FILE_SIZE=10485760 # 10MB in bytes
UPLOAD_DEST=./public/uploads

# Mailer Configuration (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=smtp_username
MAIL_PASS=smtp_password
MAIL_FROM="BOM ServiceHub <noreply@bomservicehub.com>"

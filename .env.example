# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=5000
API_PREFIX=api
API_VERSION=1

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:your_db_password_here@localhost:5432/bom_service_hub?schema=public&connection_limit=10"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=bom_service_hub

# JWT Authentication
JWT_SECRET=your_jwt_access_secret_key_here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRATION=7d

# Security & Session
COOKIE_SECRET=your_cookie_secret_key_here

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# File Upload Configuration
MAX_FILE_SIZE=10485760 # 10MB
UPLOAD_DEST=./public/uploads

# Mailer Configuration (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_smtp_username
MAIL_PASS=your_smtp_password
MAIL_FROM="BOM ServiceHub <noreply@birlaopenminds.com>"
